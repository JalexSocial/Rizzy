<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <DebugType>embedded</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Rizzy</PackageId>
    <Company>Michael Tanczos</Company>
    <Authors>Michael Tanczos</Authors>
    <Title>Rizzy - Asp.net and Htmx with static Blazor components</Title>
    <Description>
      This package allows you to utilize Asp.net MVC with Razor Components and htmx.
    </Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>blazor, htmx, blazor-ssr, blazor-web-app</PackageTags>
    <Copyright>Michael Tanczos</Copyright>
    <PackageIcon>rizzy.png</PackageIcon>
    <PackageProjectUrl>https://github.com/jalexsocial/Rizzy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jalexsocial/Rizzy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <GenerateCompatibilitySuppressionFile>true</GenerateCompatibilitySuppressionFile>
	<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- Ship XML docs so consumers get IntelliSense. Version comes from ../../Directory.Build.props. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

	<ItemGroup>
	  <!-- Tooling files that must never be packed into consumer projects (RIZZY-021). -->
	  <Content Remove="package.json;package-lock.json;publish/**" />
	  <None Remove="publish/**" />
	</ItemGroup>
	
	<ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.39">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Sqids" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\media\rizzy.png" Pack="true" PackagePath="\" />
  </ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(AssemblyName).Tests" />
		<ProjectReference Include="..\Rizzy.Htmx\Rizzy.Htmx.csproj" />
		<ProjectReference Include="..\Rizzy.SourceGenerators\Rizzy.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\js\" />
	</ItemGroup>

    <!--
      Ship the [RizzyParameterize] source generator to consumers (RM-C2). The project reference
      above runs it for Rizzy's own components; this packs the same assembly as an analyzer, so any
      project that references the Rizzy package can use [RizzyParameterize] too.
    -->
    <Target Name="PackRizzySourceGenerator" BeforeTargets="_GetPackageFiles">
        <MSBuild Projects="..\Rizzy.SourceGenerators\Rizzy.SourceGenerators.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_RizzyGeneratorAssembly" />
        </MSBuild>
        <ItemGroup>
            <None Include="@(_RizzyGeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        </ItemGroup>
    </Target>

    <!--
      Client assets are built by `npm run build` in packages/rizzy, which copies the bundle into
      wwwroot/js. CI verifies that the committed wwwroot/js matches a fresh build (RIZZY-023).
    -->

</Project>
