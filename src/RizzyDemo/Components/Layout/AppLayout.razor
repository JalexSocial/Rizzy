@using Rizzy

@inherits LayoutComponentBase
@inject Rizzy.Htmx.IRizzyNonceProvider NonceProvider

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css"/>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/simple-notify/dist/simple-notify.css" />
    
    <link rel="stylesheet" href="RizzyDemo.styles.css"/>

    <link rel="icon" type="image/png" href="favicon.png"/>
    <RzHeadOutlet/>
    @* htmx (pinned, with SRI), rizzy.js and the extensions enabled in Program.cs, all nonced. *@
    <RzScripts/>
</head>
<body>
@Body

<script nonce="@Nonce">
    // Collapse the mobile menu after a navigation click (was an inline onclick, which the CSP blocks).
    document.addEventListener("click", (e) => {
        if (e.target.closest(".nav-scrollable")) document.querySelector(".navbar-toggler")?.click();
    });
</script>

</body>
</html>

@code {
    private string Nonce => NonceProvider.GetNonce();
}
