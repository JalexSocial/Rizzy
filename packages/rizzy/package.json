{
  "name": "@jalexsocial/rizzy",
  "version": "5.4.0",
  "description": "Client library for Asp.net Rizzy",
  "main": "./dist/js/rizzy.js",
  "exports": {
    ".": "./dist/js/rizzy.js",
    "./min": "./dist/js/rizzy.min.js"
  },
  "unpkg": "./dist/js/rizzy.min.js",
  "jsdelivr": "./dist/js/rizzy.min.js",
  "files": [
    "dist/"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:dev && npm run build:prod",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "watch": "vite build --mode development --watch",
    "analyze": "vite build --mode analyze",
    "prepublishOnly": "npm run build",
    "test": "node --test ./tests/*.test.mjs",
    "validate:htmx4": "node ./scripts/validate-htmx4.js",
    "build:check": "npm run build && npm run validate:htmx4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jalexsocial/rizzy.git"
  },
  "keywords": [
    "asp.net",
    "blazor",
    "htmx",
    "razor",
    "mvc"
  ],
  "author": "Michael Tanczos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jalexsocial/rizzy/issues"
  },
  "homepage": "https://github.com/jalexsocial/rizzy#readme",
  "peerDependencies": {
    "htmx.org": "^4.0.1"
  },
  "devDependencies": {
    "fs-extra": "^11.3.0",
    "htmx.org": "^4.0.1",
    "jsdom": "^26.1.0",
    "rollup-plugin-visualizer": "^6.0.0",
    "vite": "^6.4.6"
  }
}
